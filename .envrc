# Initialize SDKMAN if available
if [[ -f "/opt/homebrew/opt/sdkman-cli/libexec/bin/sdkman-init.sh" ]]; then
    export SDKMAN_DIR="/opt/homebrew/opt/sdkman-cli/libexec"
elif [[ -f "/usr/local/opt/sdkman-cli/libexec/bin/sdkman-init.sh" ]]; then
    export SDKMAN_DIR="/usr/local/opt/sdkman-cli/libexec"
elif [[ -d "$HOME/.sdkman" ]]; then
    export SDKMAN_DIR="$HOME/.sdkman"
fi

if [[ -n "$SDKMAN_DIR" && -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]]; then
    source "$SDKMAN_DIR/bin/sdkman-init.sh"

    # Use Java 21 (LTS) - adjust version as needed
    if sdk list java 2>/dev/null | grep -q "21.0"; then
        sdk use java 21.0.5-tem 2>/dev/null || sdk use java 21-tem 2>/dev/null || true
    fi

    if [[ -n "$JAVA_HOME" ]]; then
        echo "☕️ Java: $(java -version 2>&1 | head -1)"
    fi
fi

# Fallback: try macOS java_home utility
if [[ -z "$JAVA_HOME" ]]; then
    if command -v /usr/libexec/java_home &>/dev/null; then
        export JAVA_HOME=$(/usr/libexec/java_home 2>/dev/null) || true
        if [[ -n "$JAVA_HOME" ]]; then
            echo "☕️ Java (system): $JAVA_HOME"
        fi
    fi
fi

# Maven settings (if needed)
if command -v mvn &>/dev/null; then
    export MAVEN_OPTS="${MAVEN_OPTS:--Xmx512m}"
fi

# Gradle settings (if needed)
if command -v gradle &>/dev/null; then
    export GRADLE_OPTS="${GRADLE_OPTS:--Xmx512m}"
fi

# Rust settings
export CARGO_INCREMENTAL=1

# Show status
if [[ -n "$JAVA_HOME" ]]; then
    echo "🦀 Antler dev environment ready"
    echo "   JAVA_HOME: $JAVA_HOME"
else
    echo "⚠️  No Java found - comparison tests will be skipped"
    echo "   Install Java with: sdk install java 21.0.5-tem"
fi
