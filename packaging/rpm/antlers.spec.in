# Disable stripping - binary may be cross-compiled and host strip can't process it
%define __strip /bin/true
%define debug_package %{nil}

Name:           @@BINARY_NAME@@
Version:        @@VERSION@@
Release:        @@RELEASE@@
Summary:        CLI tool for JVM dependency resolution@@SUMMARY_SUFFIX@@
License:        Apache-2.0 OR MIT
URL:            https://github.com/albertocavalcante/antlers

%description
A fast, reliable tool for resolving and managing JVM dependencies.
@@DESCRIPTION_EXTRA@@

%install
mkdir -p %{buildroot}/usr/bin
cp %{_sourcedir}/@@BINARY_NAME@@ %{buildroot}/usr/bin/
chmod 755 %{buildroot}/usr/bin/@@BINARY_NAME@@

%files
/usr/bin/@@BINARY_NAME@@
